          <object caption='Custom SQL Query' id='_4BF12C471D484858AFAA64EDC4A2D7E0'>
            <properties context=''>
              <relation connection='postgres.1mf0hh208wcnmv1ac5jhn01ywzov' name='Custom SQL Query' type='text'>SELECT * FROM order_by_country_user</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query5' id='_553C4E1A9BF54305AD02EC3B4966A31D'>
            <properties context=''>
              <relation connection='postgres.1mf0hh208wcnmv1ac5jhn01ywzov' name='Custom SQL Query5' type='text'>SELECT * FROM campaign_profit</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query3' id='_92CD455BA37D4578A481F05A96AB3CBF'>
            <properties context=''>
              <relation connection='postgres.1mf0hh208wcnmv1ac5jhn01ywzov' name='Custom SQL Query3' type='text'>SELECT * FROM sales_trend</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query2' id='_965FF0A9A0DD41A1B4E76711985FC553'>
            <properties context=''>
              <relation connection='postgres.1mf0hh208wcnmv1ac5jhn01ywzov' name='Custom SQL Query2' type='text'>SELECT
	m.merchant_country,
	ROUND(SUM(o.quantity * o.price)::double precision:: numeric,2) AS profit
FROM dim_merchant AS m
LEFT JOIN fact_order AS o
ON o.merchant_reference_number = m.merchant_reference_number
GROUP BY m.merchant_country
ORDER BY profit DESC</relation>
            </properties>
          </object>
          <object caption='Custom SQL Query4' id='_FDFBC380F8E844CD868BED442847E352'>
            <properties context=''>
              <relation connection='postgres.1mf0hh208wcnmv1ac5jhn01ywzov' name='Custom SQL Query4' type='text'>select * from staff_performance</relation>
            </properties>
          </object>
